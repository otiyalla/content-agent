# Anthropic (primary LLM)
ANTHROPIC_API_KEY=your_anthropic_api_key

# OpenAI Configuration (fallback LLM)
OPENAI_API_KEY=your_openai_api_key

# xAI Grok (second fallback LLM)
XAI_API_KEY=your_xai_api_key
# XAI_MODEL=grok-4.7
# XAI_MODEL_SIMPLE=grok-4.3

# Tavily Configuration (Research)
TAVILY_API_KEY=your_tavily_api_key

# Twitter / X API Configuration
TWITTER_APP_KEY=your_twitter_api_key
TWITTER_APP_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_SECRET=your_twitter_access_secret

# Reddit API Configuration
REDDIT_USER_AGENT="ZenlotContentAgent/1.0.0 by YourUsername"
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USERNAME=your_reddit_username
REDDIT_PASSWORD=your_reddit_password

# Email Configuration (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
EMAIL_FROM="Zenlot Agent <your_email@gmail.com>"
EMAIL_TO="info@zenlot.net"
# Also gets the comment digest while OWNER_AWAY=true (docs/INCIDENTS.md)
# SAFETY_BACKUP_EMAIL=

# Instagram (see docs/INSTAGRAM.md)
IG_USER_ID=your_instagram_user_id
IG_ACCESS_TOKEN=your_long_lived_instagram_token
IG_HANDLE=@zenlot_app
# IG_GRAPH_VERSION=v27.0

# Cloudflare R2 (public image hosting for Instagram)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=zenlot-social
R2_PUBLIC_BASE_URL=https://social.zenlot.net

# Application Settings
DRY_RUN=true # Set to false to actually post and send emails
AGENTS_AUTOPOST=false # X/Reddit: false = email drafts for approval; true = post drafts that pass the brand check
# OWNER_AWAY=true # Nothing publishes and no drafts are sent; the comment digest continues
# RADAR_COMPETITOR_NAMES=Name One,Name Two # Kept out of saved plans. Never commit the list
