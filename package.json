{
  "name": "zenlot-content-agent",
  "version": "1.0.0",
  "description": "Content creation and social management agent for Zenlot",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "run:hunter": "ts-node src/workflows/pain-point-hunter.ts",
    "run:creator": "ts-node src/workflows/content-creator.ts",
    "run:engager": "ts-node src/workflows/community-engager.ts",
    "run:reddit": "ts-node src/workflows/reddit-community.ts",
    "ig:plan": "ts-node src/workflows/instagram-planner.ts",
    "ig:publish": "ts-node src/workflows/instagram-publisher.ts",
    "ig:preview": "ts-node src/workflows/instagram-preview.ts",
    "ig:token": "ts-node src/workflows/instagram-token.ts",
    "ig:whoami": "ts-node src/workflows/instagram-whoami.ts",
    "r2:check": "ts-node src/workflows/r2-check.ts",
    "golive:check": "ts-node src/workflows/golive-check.ts",
    "ig:profile-assets": "ts-node src/instagram/profile-assets.ts",
    "ig:comments": "ts-node src/workflows/instagram-comments.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@aws-sdk/client-s3": "^3.1171.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tavily/core": "^0.0.2",
    "dotenv": "^16.4.5",
    "jpeg-js": "^0.4.4",
    "nodemailer": "^6.9.13",
    "openai": "^4.47.1",
    "satori": "^0.18.0",
    "snoowrap": "^1.23.0",
    "twitter-api-v2": "^1.16.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jpeg-js": "^0.3.0",
    "@types/node": "^20.12.12",
    "@types/nodemailer": "^6.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20"
  }
}
